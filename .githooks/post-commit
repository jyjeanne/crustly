#!/bin/sh
# Rebuilds docs/graph/ (Rust source only, no LLM) after commits that touch code,
# and commits the result. Installed via scripts/setup-graphify-hooks.sh.
#
# Safe against recursion: the commit this hook creates only touches docs/graph/,
# which never matches the pathspec filter below, so it does not re-trigger itself.

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

CHANGED=$(git diff --name-only HEAD~1 HEAD -- '*.rs' 'Cargo.toml' 'Cargo.lock' 2>/dev/null)
[ -z "$CHANGED" ] && exit 0

echo "[graphify hook] code changed - updating docs/graph"
# Run directly (not via `sh`) so the script's own bash shebang applies -
# invoking a bash script with `sh` breaks bashisms like `set -o pipefail`.
"$REPO_ROOT/scripts/update-knowledge-graph.sh" --quiet --commit || \
  echo "[graphify hook] graph update failed - run scripts/update-knowledge-graph.sh manually"

exit 0
