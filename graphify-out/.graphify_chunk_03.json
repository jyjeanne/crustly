      "id": "docs_guides_build_notes_sqlite_conflict_resolution",
      "label": "SQLite Conflict Resolution",
      "file_type": "rationale",
      "source_file": "/home/user/crustly/docs/guides/BUILD_NOTES.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "rusqlite was removed because rusqlite 0.31 uses libsqlite3-sys 0.28 while sqlx 0.7 uses libsqlite3-sys 0.26, and Cargo forbids multiple versions linking the same native library. Only sqlx is used for database operations, and migrations use sqlx-cli instead of refinery."
