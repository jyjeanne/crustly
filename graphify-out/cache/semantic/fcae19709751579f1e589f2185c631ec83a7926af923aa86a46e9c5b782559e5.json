{"nodes": [{"id": "docs_development_sprint_1_complete_sprint_1", "label": "Sprint 1: Database Layer", "file_type": "document", "source_file": "docs/development/SPRINT_1_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_development_sprint_1_complete_database_layer", "label": "Database Layer (SQLite + SQLx)", "file_type": "concept", "source_file": "docs/development/SPRINT_1_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design decisions: Unix timestamps over ISO strings for simplicity and performance; foreign key cascades for automatic cleanup; archive (soft delete) instead of hard delete for sessions; connection pool capped at 5 for SQLite WAL mode; in-memory database support for fast tests."}, {"id": "docs_development_sprint_1_complete_repository_pattern", "label": "Repository Pattern", "file_type": "concept", "source_file": "docs/development/SPRINT_1_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Session, Message, and File repositories behind a common async Repository<T> trait provide clean separation between data access and business logic; prepared statements via SQLx give type-safe, injection-resistant queries."}, {"id": "docs_development_sprint_1_complete_token_tracking", "label": "Token & Cost Tracking", "file_type": "concept", "source_file": "docs/development/SPRINT_1_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Message schema tracks input/output/reasoning/cache_creation/cache_read tokens and cost as optional fields to stay flexible across model types, including prompt caching support."}], "edges": [{"source": "docs_development_sprint_1_complete_sprint_1", "target": "docs_development_sprint_0_complete_sprint_0", "relation": "refere