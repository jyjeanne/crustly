{"nodes": [{"id": "docs_guides_lm_studio_guide_lm_studio", "label": "LM Studio Local LLM Server", "file_type": "concept", "source_file": "docs/guides/LM_STUDIO_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local LLMs are supported for 100% privacy (code never leaves the machine), zero cost, offline use, and no rate limits, at the price of slower responses and 16GB+ RAM requirements versus cloud models."}, {"id": "docs_guides_lm_studio_guide_openai_base_url", "label": "OPENAI_BASE_URL Environment Variable", "file_type": "concept", "source_file": "docs/guides/LM_STUDIO_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single environment variable redirects the OpenAI provider to any OpenAI-compatible local server (LM Studio, Ollama, LocalAI, Text Generation WebUI) with no extra setup; the /v1 suffix is required."}, {"id": "docs_guides_lm_studio_guide_provider_priority", "label": "Provider Selection Priority", "file_type": "rationale", "source_file": "docs/guides/LM_STUDIO_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Providers are selected in order: local LLM if OPENAI_BASE_URL is set, then OpenAI if OPENAI_API_KEY is set, then Anthropic if ANTHROPIC_API_KEY is set - preferring explicit local configuration over cloud keys."}, {"id": "docs_guides_lm_studio_guide_openai_compatible_api", "label": "OpenAI-Compatible API", "file_type": "concept", "source_file": "docs/guides/LM_STUDIO_GUIDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_guides_lm_studio_guide_openai_base_url", "target": "docs_guides_lm_studio_guide_lm_studio", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/LM_ST