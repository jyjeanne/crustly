{"nodes": [{"id": "readme_crustly", "label": "Crustly", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rust reimplementation of Crush chosen for speed and memory efficiency; targets 95%+ feature parity with superior performance; terminal-native so developers stay in their workflow."}, {"id": "readme_crush", "label": "Crush (Go Original)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_interactive_approval_system", "label": "Interactive Approval System", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dangerous operations (file writes, shell commands) always require explicit approval while safe reads proceed automatically \u2014 full user control with transparency into parameters before deciding."}, {"id": "readme_auto_mode", "label": "Auto Mode", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three autonomy tiers (Interactive/AutoPlan/FullAuto) cycled via Shift+Tab. The [security] config policy is a separate earlier check never bypassed by Auto Mode \u2014 the hard floor \u2014 and every auto-approved action is logged identically to manual approvals for a full audit trail."}, {"id": "readme_local_llm_support", "label": "Local LLM Support", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "100% private (code never leaves the machine), zero API cost, and offline operation \u2014 also recommended as the compliant alternative to ToS-violating Claude Max / Copilot OAuth workarounds."}, {"id": "readme_lm_studio", "label": "LM Studio", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ollama", "label": "Ollama", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended local backend over LM Studio because it runs as an always-on daemon (no GUI to accidentally close), fitting Crustly's 10-second connect timeout and 90-second connection pool."}, {"id": "readme_native_ollama_provider", "label": "Native Ollama Provider", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Speaks Ollama's native /api/chat protocol alongside the OpenAI-compatible route, unlocking runtime performance metrics, keep_alive/num_ctx control, and in-TUI model download/switch that the OpenAI shim cannot provide."}, {"id": "readme_context_compaction", "label": "Context Compaction", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggers at 80% window capacity; older turns summarised, last 10 preserved verbatim; a CompactionRecord is written to SQLite before any context is modified so a failed compaction leaves the session untouched."}, {"id": "readme_smart_model_routing", "label": "Smart Model Routing", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Picks fast/balanced/powerful model tier via local keyword classification in microseconds \u2014 deliberately avoids an extra API call for routing."}, {"id": "readme_parallel_tool_dispatch", "label": "Parallel Tool Dispatch", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Independent read-only tool calls execute concurrently via join_all; benchmarked >=40% faster than sequential dispatch on 10 concurrent reads (62% measured)."}, {"id": "readme_tool_result_caching", "label": "Tool Result Caching", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only read-only tools (read_file, glob, grep) are cached with configurable TTL; write tools are never cached to avoid stale/incorrect state."}, {"id": "readme_provider_failover", "label": "Provider Failover", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automatic retry on a secondary provider on rate-limit or timeout; failover events tagged [FAILOVER] in logs for observability."}, {"id": "readme_sandbox_permission_policy", "label": "Sandbox & Permission Policy", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Symlink and ../ escapes outside project root denied at the tool layer with no prompt; bash allowlist; composable AndPolicy where the first Deny wins."}, {"id": "readme_episodic_memory", "label": "Episodic Memory", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past-session summaries injected into new contexts within a token budget; oversized summaries are truncated rather than dropped so the budget is filled exactly."}, {"id": "readme_codebase_index", "label": "Codebase Index", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File watcher (notify crate) re-indexes Rust sources on save; symbol index supports query_symbol and fts_search."}, {"id": "readme_mcp_integration", "label": "MCP Tool Server Integration", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External MCP servers auto-registered at startup from [[mcp.servers]] config; built-in tool names take precedence; crashed servers return graceful errors \u2014 no panics or hangs."}, {"id": "readme_reasoning_display", "label": "Reasoning Display", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unifies three reasoning sources (Anthropic ThinkingDelta, DeepSeek-R1 reasoning_content, Ollama <think> tags) into one collapsible panel; collapsed by default to keep the chat clean."}, {"id": "readme_streaming_tui", "label": "Real-time Streaming TUI", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Token-by-token rendering with a live [streaming] label; <think> content is filtered from the live view so the user only ever sees clean visible text during generation."}, {"id": "readme_phase_4_tools", "label": "Phase 4 Tools (Claw Code Parity)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "web_fetch, todo_write, ask_user, skill, agent, powershell bring full tool-set parity with Claw Code; sub-agents are recursion-safe \u2014 agents spawned by AgentTool cannot themselves spawn further sub-agents."}, {"id": "readme_os_keyring", "label": "OS Keyring API Key Storage", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "API keys encrypted by the OS credential manager (Windows Credential Manager / macOS Keychain / Linux Secret Service) instead of plaintext files; keyring tried first with environment variables as fallback."}, {"id": "readme_slash_discovery_commands", "label": "/skills and /mcp Discovery Commands", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intercepted before being sent to the LLM; a message starting with / that isn't a known command still goes to the LLM so file paths are not swallowed."}], "edges": [{"source": "readme_crustly", "target": "license_fsl_1_1_mit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_crustly", "target": "readme_interactive_approval_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_crustly", "target": "readme_auto_mode", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_crustly", "target": "readme_local_llm_support", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_crustly", "target": "readme_native_ollama_provider", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_crustly", "target": "readme_context_compaction", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 