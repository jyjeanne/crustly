{"nodes": [{"id": "docs_guides_debug_logging_conditional_file_logging", "label": "Conditional File Logging", "file_type": "rationale", "source_file": "docs/guides/DEBUG_LOGGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Log files are only created when debug mode (-d) is explicitly enabled, to keep the workspace clean, avoid privacy issues (logs contain user data), avoid disk bloat (7-day auto-cleanup), and stay silent so logging never interferes with the TUI. Logs live in a git-ignored local .crustly/logs/ folder."}, {"id": "docs_guides_debug_logging_logconfig", "label": "LogConfig", "file_type": "code", "source_file": "docs/guides/DEBUG_LOGGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guides_debug_logging_init_logging", "label": "init_logging", "file_type": "code", "source_file": "docs/guides/DEBUG_LOGGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_guides_debug_logging_tracing", "label": "Rust tracing Ecosystem", "file_type": "concept", "source_file": "docs/guides/DEBUG_LOGGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen for high-performance structured logging with minimal overhead when disabled (tracing, tracing-subscriber, tracing-appender)."}, {"id": "docs_guides_debug_logging_logs_cli", "label": "Log Management CLI (crustly logs)", "file_type": "concept", "source_file": "docs/guides/DEBUG_LOGGING.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_guides_debug_logging_init_logging", "target": "docs_guides_debug_logging_conditional_file_logging", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/guides/DEBUG_LOGG