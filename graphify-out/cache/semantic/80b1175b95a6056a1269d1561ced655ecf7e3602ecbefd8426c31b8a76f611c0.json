{"nodes": [{"id": "docs_development_approval_system_complete_tool_approval_system", "label": "Tool Approval System", "file_type": "rationale", "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interactive approval gives users full control over dangerous AI tool actions (file writes, shell commands). Dangerous capabilities (WriteFiles, ExecuteShell, SystemModification) always require approval by default; safe tools like read_file skip approval. Checks occur at three levels: tool, agent service, and user."}, {"id": "docs_development_approval_system_complete_approval_callback", "label": "Approval Callback (async callback pattern)", "file_type": "rationale", "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Async callback lets the agent service wait non-blockingly for the user's decision via async/await, staying compatible with streaming responses while decoupling the agent from the TUI."}, {"id": "docs_development_approval_system_complete_channel_based_communication", "label": "Channel-Based Communication", "file_type": "rationale", "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each approval request carries its own mpsc response channel, giving a clean async/await flow with no shared mutable state between the agent service and the TUI."}, {"id": "docs_development_approval_system_complete_capability_based_permissions", "label": "Capability-Based Permissions", "file_type": "rationale", "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tools declare capabilities; dangerous capabilities automatically require approval. Chosen for extensibility so future tool types inherit correct security behavior without per-tool policy code."}, {"id": "docs_development_approval_system_complete_approval_dialog", "label": "Modal Approval Dialog", "file_type": "concept", "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-screen modal prevents any other interaction, forcing focus on the security decision; two-view mode (simple vs detailed JSON) balances quick decisions against thorough review."}, {"id": "docs_development_approval_system_complete_auto_approve_mode", "label": "Auto-Approve Mode", "file_type": "concept", "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bypass mechanism kept only for trusted/testing scenarios (--auto-approve flag or with_auto_approve_tools); explicitly flagged as dangerous and not recommended for normal use."}], "edges": [{"source": "docs_development_approval_system_complete_approval_callback", "target": "docs_development_approval_system_complete_tool_approval_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_approval_system_complete_channel_based_communication", "target": "docs_development_approval_system_complete_tool_approval_system", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_approval_system_complete_capability_based_permissions", "target": "docs_development_approval_system_complete_tool_approval_system", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_approval_system_complete_approval_dialog", "target": "docs_development_approval_system_complete_tool_approval_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_approval_system_complete_auto_approve_mode", "target": "docs_development_approval_system_complete_tool_approval_system", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_approval_system_complete_tool_approval_system", "target": "docs_development_sprint_4_plan_tool_framework", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "tool_approval_architecture", "label": "Tool Approval System Architecture", "nodes": ["docs_development_approval_system_complete_tool_approval_system", "docs_development_approval_system_complete_approval_callback", "docs_development_approval_system_complete_channel_based_communication", "docs_development_approval_system_complete_approval_dialog", "docs_development_approval_system_complete_capability_based_permissions"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/APPROVAL_SYSTEM_COMPLETE.md"}]}