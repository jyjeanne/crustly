{"nodes": [{"id": "docs_development_improvement_roadmap_improvement_roadmap", "label": "Crustly Improvement Roadmap", "file_type": "document", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_development_improvement_roadmap_multi_provider_support", "label": "Multi-Provider Support", "file_type": "rationale", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rated critical because users expect multi-provider support as advertised \u2014 config supports 6+ providers but only Anthropic worked, making it a production blocker for 1.0."}, {"id": "docs_development_improvement_roadmap_error_recovery_resilience", "label": "Error Recovery & Resilience", "file_type": "rationale", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rated critical because the implementation could crash or hang on network issues; production apps need retry with exponential backoff, timeouts, rate-limit handling, and crash recovery."}, {"id": "docs_development_improvement_roadmap_security_hardening", "label": "Security Hardening", "file_type": "rationale", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rated critical because handling user code and API keys requires robust security \u2014 keys were stored in plaintext; plan includes OS keyring storage, path validation, bash sanitization, tool blacklist, and audit log."}, {"id": "docs_development_improvement_roadmap_enhanced_tool_system", "label": "Enhanced Tool System", "file_type": "concept", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 3 tools (read, write, bash) existed \u2014 too limited for real coding workflows; plan adds List, Search, Git, WebFetch, Editor, Diff, Test, and Lint tools."}, {"id": "docs_development_improvement_roadmap_approval_system_v2", "label": "Approval System v2 Enhancements", "file_type": "concept", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v1 approval is functional but limited; v2 adds session memory, whitelists, diff preview, approval history, bulk approve, pattern matching, dry run, and audit export to improve workflow."}, {"id": "docs_development_improvement_roadmap_local_llm_integration", "label": "Local LLM Integration", "file_type": "concept", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Local LLM support (LM Studio, Ollama) is a key differentiator but was documented yet untested; verification and auto-detection of localhost providers required before it can be claimed."}, {"id": "docs_development_improvement_roadmap_mcp_protocol_support", "label": "MCP Protocol Support", "file_type": "concept", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MCP enables ecosystem extensions (server/client protocol, stdio/HTTP/WebSocket transports, MCP tool adapter) but is medium priority since it is not critical for core functionality."}, {"id": "docs_development_improvement_roadmap_lsp_integration", "label": "LSP Integration", "file_type": "concept", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LSP adds code intelligence (definitions, references, diagnostics via tower-lsp) but requires significant effort; classified nice-to-have at medium priority."}, {"id": "docs_development_improvement_roadmap_plugin_system", "label": "Plugin System (WASM)", "file_type": "concept", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "WASM-based plugin runtime with sandboxing deferred to lowest priority: a major 7-10 day undertaking that benefits mostly power users and developers."}, {"id": "docs_development_improvement_roadmap_quick_wins", "label": "Quick Wins (High Value, Low Effort)", "file_type": "concept", "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five ~6-hour fixes prioritized for immediate impact: fix hard-coded model in render.rs, custom config path support, connection timeout, approval timeout, and a first database benchmark."}], "edges": [{"source": "docs_development_improvement_roadmap_improvement_roadmap", "target": "docs_development_improvement_roadmap_multi_provider_support", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_improvement_roadmap_improvement_roadmap", "target": "docs_development_improvement_roadmap_error_recovery_resilience", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/development/IMPROVEMENT_ROADMAP.md", "source_location": null, "weight": 1.0}, {"source": "docs_development_improvement_roadmap_improvement_roadmap", "target": "docs_development_improvement_roadmap_security_hardening", "relation": "references", "confidence": "EXTRACTED", "confidence_s