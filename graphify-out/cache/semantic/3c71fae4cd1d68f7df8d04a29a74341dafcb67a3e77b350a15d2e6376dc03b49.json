{"nodes": [{"id": "docs_test_manually_test_plan_mod_plan_mode", "label": "Plan Mode Sequential Task Execution", "file_type": "concept", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Workflow: AI builds a structured plan (plan tool, add_task, finalize), the user reviews and approves (Ctrl+A) or rejects (Ctrl+R), then tasks auto-execute sequentially in dependency order with state Pending -> InProgress -> Completed, persisted after each task so interrupted executions can be resumed."}, {"id": "docs_test_manually_test_plan_mod_execute_plan_tasks", "label": "execute_plan_tasks", "file_type": "code", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_test_manually_test_plan_mod_execute_next_plan_task", "label": "execute_next_plan_task", "file_type": "code", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_test_manually_test_plan_mod_complete_response", "label": "complete_response", "file_type": "code", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_test_manually_test_plan_mod_topological_sort", "label": "Topological Sort of Task Dependencies", "file_type": "concept", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tasks execute in dependency order via topological sort so no task starts before its dependencies complete."}, {"id": "docs_test_manually_test_plan_mod_circular_dependency_detection", "label": "Circular Dependency Detection", "file_type": "concept", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validation blocks finalizing plans containing dependency cycles, preventing execution deadlock; a clear 'Circular dependency detected' error is surfaced."}, {"id": "docs_test_manually_test_plan_mod_crustly_plan_json", "label": ".crustly_plan.json State File", "file_type": "concept", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan state (task statuses, timestamps, approval/rejection) is persisted to .crustly_plan.json after every task update so interrupted executions survive force-quit and can be resumed or restarted."}, {"id": "docs_test_manually_test_plan_mod_read_only_mode", "label": "Plan Mode Read-Only Tool Restriction", "file_type": "concept", "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While planning, write operations are blocked ('Write operations not allowed in Plan mode') and only read-only tools (ls, read_file, grep) work, so plans cannot mutate the workspace before approval."}], "edges": [{"source": "docs_test_manually_test_plan_mod_execute_plan_tasks", "target": "docs_test_manually_test_plan_mod_execute_next_plan_task", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "weight": 1.0}, {"source": "docs_test_manually_test_plan_mod_complete_response", "target": "docs_test_manually_test_plan_mod_execute_next_plan_task", "relation": "calls", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/test-manually/test-plan-mod.md", "source_location": null, "weight": 1.0}, {"source": "docs_test_manually_test_plan_mod_execute_next_plan_task